// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  email       String   @id
  displayName String?
  jobTitle    String?
  department  String?
  country     String?
  employeeId  String?
  chatSessions ChatSession[]
}

model ChatSession {
  id          String    @id @default(cuid())
  userEmail   String    @default("")
  // Restrict, not Cascade: deleting a User must never take their chat history
  // with it. Sessions are only ever soft-deleted via the isDeleted flag.
  user        User      @relation(fields: [userEmail], references: [email], onDelete: Restrict)
  botId       String
  title       String    @default("New Conversation")
  // True once a human has renamed the thread. The auto-summary only ever
  // writes a title that is still the one the app guessed, so a name somebody
  // chose is never overwritten by one a model wrote.
  titleSetByUser Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Thumbs up or down on an assistant answer: 'up', 'down', or null when the
  // user has not rated it or has taken a rating back. Nullable rather than a
  // default so "not rated" and "rated neutral" stay different things.
  feedback   String?
  feedbackAt DateTime?

  // Why, in the user's own words or in one of the offered ones. Both optional
  // on purpose: the thumb saves on its own click and the reason is an extra
  // that can be skipped, because a rating that demands a form is a rating
  // nobody gives. feedbackReason is one of the ids in siteConfig.text.feedback
  // .reasons; feedbackNote is free text, only ever set alongside it.
  feedbackReason String?
  feedbackNote   String?  @db.Text

  // An admin's own verdict, given from the admin pages on somebody else's
  // conversation. Deliberately its own column rather than writing over the
  // user's thumb above: most answers are never rated by the person who got
  // them, and where the two do disagree that disagreement is the signal worth
  // keeping. adminFeedbackBy is the admin's email, so a queue of flagged
  // answers can say who flagged each one.
  //
  // The reason and note mirror the user's pair above rather than reusing
  // reviewNote below: that one is the conclusion reached afterwards, often by
  // somebody else, and a quick flag written from a transcript must not
  // overwrite it.
  adminFeedback       String?
  adminFeedbackBy     String?
  adminFeedbackAt     DateTime?
  adminFeedbackReason String?
  adminFeedbackNote   String?   @db.Text

  // Triage, written from /admin/feedback rather than by the user. The note is
  // what was actually wrong with the answer, which the thumb on its own never
  // says; reviewStatus is 'resolved' once it has been dealt with, and null
  // while it is still open.
  reviewNote   String?   @db.Text
  reviewStatus String?
  reviewedAt   DateTime?

  // Why this answer stops where it does: 'stopped' when the user pressed stop,
  // 'interrupted' when the connection dropped partway, null when it finished.
  // Stored rather than kept in page state so a reloaded conversation still
  // says so - a truncated answer that looks whole is a wrong answer, and it is
  // also the difference between a real thumbs-down and a cut-off one.
  incomplete String?

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/**
 * What a table, view, tool or column is called in front of a user.
 *
 * Only the edits. The defaults live in src/config/dataNames.ts and are layered
 * under whatever is here, so a row exists only where somebody changed the
 * wording - which makes "restore the default" a delete rather than a lookup,
 * and means a new default ships without having to migrate anything.
 */
model DisplayName {
  // The real name, exactly as the agents write it: core.supplychain.
  key       String   @id
  label     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/**
 * Why an answer never arrived.
 *
 * The user always sees the same line - the chatbot is busy, try again - which
 * is the right thing to show and the wrong thing to keep. Every real cause
 * behind it used to end in a console nobody reads, so a timeout, a dead
 * webhook and a malformed reply were indistinguishable after the fact.
 *
 * Separate from Message on purpose: a failure has no conversation turn to
 * belong to, and a row here must survive the session being deleted.
 */
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userEmail String?
  sessionId String?
  botId     String?

  // Where it broke: 'upstream' (n8n answered with a failure), 'timeout',
  // 'network' (never got a reply), 'malformed' (a reply we could not use),
  // or 'session' (could not start or load the conversation).
  stage   String
  // The HTTP status, when there was one to have.
  status  Int?
  // The real error, in the words of whatever produced it.
  message String  @db.Text
  // Upstream body or stack, truncated. The part that actually says what broke.
  detail  String? @db.Text
  // What the user had asked, so the failure can be reproduced.
  question String? @db.Text

  // Triage, same as a rated answer.
  reviewNote   String?   @db.Text
  reviewStatus String?
  reviewedAt   DateTime?

  @@index([createdAt])
  @@index([reviewStatus])
}

/**
 * One guardrail rule firing on one message.
 *
 * Sits beside ErrorLog and is shaped like it on purpose: standalone, no foreign
 * key on sessionId so a row survives the conversation being deleted, indexed on
 * time and on triage state, and carrying the same reviewNote / reviewStatus /
 * reviewedAt triad the other two admin queues already drive.
 *
 * `enforced` is the honest record of what actually happened to the request, not
 * what the rule would like to have happened. While a rule is shadowing, this is
 * false and the answer went through - which is the whole point of shadow mode,
 * and the thing that would be impossible to reconstruct later if only the
 * verdict were stored.
 *
 * `falsePositive` is set by hand from the console. It is the number that
 * decides whether a rule is ready to enforce, so it earns a column rather than
 * living inside the review note.
 */
model GuardrailEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userEmail String?
  sessionId String?
  botId     String?

  // 'input' (what was asked), 'output' (what came back), 'sql' (what an agent
  // tried to run). The last is written by n8n rather than by the app.
  surface String
  // Which rule, from src/lib/guardrails/rules.ts.
  ruleId   String
  severity String
  // 'allow' is never stored - only a rule that matched is worth a row.
  verdict  String
  // Whether the request was actually stopped. False while shadowing.
  enforced Boolean @default(false)

  // The span that matched, clipped. Enough to judge the rule, not the whole
  // message - the message is already on Message, and copying it here would
  // duplicate everything a conversation holds into a second table.
  excerpt  String? @db.Text
  // What was asked, for an output or sql event where the excerpt alone does
  // not say what the user was trying to do.
  question String? @db.Text

  // Set from the console when a match turns out to be wrong. Null means
  // nobody has judged it yet, which is different from false.
  falsePositive Boolean?

  reviewNote   String?   @db.Text
  reviewStatus String?
  reviewedAt   DateTime?

  @@index([createdAt])
  @@index([reviewStatus])
  @@index([ruleId])
}

/**
 * A rule whose action has been changed from its default.
 *
 * Sparse, exactly like DisplayName: a row exists only where somebody moved a
 * rule off the setting it ships with, so "has this been changed?" is answered
 * by the row existing, and restoring the default is a delete rather than a
 * lookup. The defaults live in src/lib/guardrails/rules.ts and a new rule
 * ships without needing a migration.
 */
model GuardrailRule {
  id        String   @id
  // 'off' | 'shadow' | 'enforce'
  action    String
  updatedAt DateTime @updatedAt
  updatedBy String?
}
