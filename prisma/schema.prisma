// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  email       String   @id
  displayName String?
  jobTitle    String?
  department  String?
  country     String?
  employeeId  String?
  chatSessions ChatSession[]
}

model ChatSession {
  id          String    @id @default(cuid())
  userEmail   String    @default("")
  // Restrict, not Cascade: deleting a User must never take their chat history
  // with it. Sessions are only ever soft-deleted via the isDeleted flag.
  user        User      @relation(fields: [userEmail], references: [email], onDelete: Restrict)
  botId       String
  title       String    @default("New Conversation")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isDeleted   Boolean   @default(false)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Thumbs up or down on an assistant answer: 'up', 'down', or null when the
  // user has not rated it or has taken a rating back. Nullable rather than a
  // default so "not rated" and "rated neutral" stay different things.
  feedback   String?
  feedbackAt DateTime?

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
